{
    // ════════════════════════════════════════════════════════════════
    //  BBHelper — 崩坏学园2 日常清理脚本
    //
    //  坐标系：1280×720 横屏（短边即 720）
    //  连接方式：MuMu 模拟器走 ADB。⚠️ 用 Win32 窗口方式连接会黑屏。
    //  游戏包名：com.miHoYo.HSoDv2Original（官服）
    //
    //  ⚠️ 安全约定（主号）：
    //    本脚本对「消耗资源 / 不可逆」的操作一律**默认关闭**，
    //    需要用户在界面上显式打开对应开关才会执行。
    //    带 ⚡ 标记的选项即属此类。详见各 option 的 description。
    //
    //  开关的实现方式：每个 option 的 pipeline_override 改写一个
    //  「切点」节点的 next —— Yes 指向任务节点，No 指向下一个切点。
    //  切点本身只做路由（DirectHit + DoNothing），不含业务逻辑。
    //  因此 **pipeline 里的默认 next = 本文件的 default_case**，两边必须一致。
    // ════════════════════════════════════════════════════════════════
    "interface_version": 2,
    "name": "BBHelper",
    "description": "崩坏学园2 日常清理：邮件领取、使魔探险、存在感每日任务（使魔的爱 / 世界那么大 / 战力补强 / 共鸣之力 / 体力消耗）、收尾领奖、每周任务。",
    "contact": "",
    "license": "MIT",
    "welcome": "使用前请确认：\n1. 游戏已在 MuMu 模拟器中运行并登录\n2. 模拟器分辨率保持 1280×720 横屏\n3. 用 ADB 方式连接，不要用 Win32 窗口方式（会黑屏）",
    "github": "",
    "version": "0.1.0",
    "controller": [
        {
            "name": "MuMu 模拟器（ADB）",
            "type": "Adb",
            // 横屏 1280×720，短边即 720
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // ════════════════════════════════════════════════════════════════
    //  Agent 配置 —— **必须填，否则所有 Custom* 节点失效**。
    //
    //  ⚠️ 本块曾经被误注释掉过（"不填插件也能用"），那是**错的**：
    //     2026-09-19 实测，注释掉之后跑日常会在第一个 Custom 节点上直接失败：
    //         [ERR][CustomAction.cpp] Action is null [param.name=phase_begin]
    //         Task.Failed
    //     当时只验证了"插件不报错"，没验证 Custom 节点能不能跑。
    //
    //  插件的真实逻辑（源码 buildRuntime + AgentClient）：
    //      const debug_session = debugSessionMapper[agent.child_exec];
    //      if (agentConfig.debug_session) { startDebugSession(...) }   // 走调试器
    //      else if (agentConfig.child_exec) { startTask(child_exec, args) }  // 当终端命令跑
    //  也就是说 child_exec 既是「可执行文件」又是「调试会话的查找键」。
    //  本机没有系统 python，走不了也不能走终端那条路，所以这里直接用
    //  **项目 venv 的 python 全路径**，让它以普通子进程方式启动。
    //
    //  路径变量：插件只认 `{PROJECT_DIR}`（单花括号，不是 ${}）。
    //  ⚠️ 它不是项目根，而是**interface.json 所在目录**（= assets/）：
    //      const projectDir = joinPath(activeResource.workspace, activeResource.dirRelative)
    //  所以下面两个路径都要 `../` 退一级才回到项目根。
    //
    //  child_args 末尾插件会自动追加 <identifier>，正好对上 main.py 的 argv[-1]。
    //
    //  ⚠️ 这也解释了开发早期那次「Python was not found」的怪事：
    //     当时写的是 "./agent/main.py"（相对 assets/），而 assets/agent/ 那时
    //     还躺着一份**陈旧副本** —— 插件跑的是它，所以 Custom 节点全找不到。
    //     副本删掉后就变成路径直接不存在了。
    //
    //  ⚠️ 发布产物由 tools/install.py 另行写入 —— 那边写的是
    //     `./python/python.exe`（包内**自带**的绿色 python，见
    //     tools/setup_embed_python.py），与这里的 venv 全路径形态不同，
    //     不要指望这一块被直接带过去。
    //
    //  ⚠️ 这里写**全路径**，不要图省事写 "python"。
    //     写上 "python" 就是把「用哪个 python」外包给 PATH，而 PATH 的第一位
    //     随时可能变成另一个没装 maafw、或者装了**版本不对**的 python。
    //     2026-09-20 这个坑在发布产物上炸过一次（用户机器上没有我们的 venv），
    //     所以才有了「把 python 打进包里」这件事。
    // ════════════════════════════════════════════════════════════════
    "agent": {
        "child_exec": "{PROJECT_DIR}/../.venv/Scripts/python.exe",
        "child_args": [
            "{PROJECT_DIR}/../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "日常清理",
            "entry": "Daily_CleanUp",
            // 顺序 = 管线里的阶段顺序，见 entry.json 的 Daily_CleanUp。
            "option": [
                "启动超时",
                "邮件领取",
                "使魔探险",
                "使魔的爱",
                "世界那么大",
                "战力补强",
                // 体力消耗的子项（关卡来源 → 预设关卡、体力目标）不在这里列 ——
                // 它们挂在「体力消耗 → Yes」的 option 里，选中时才显示。
                "体力消耗",
                "共鸣之力",
                "领取以上任务奖励",
                "每周任务"
            ]
        },
        {
            "name": "通用通关（需先停在关卡详情页）",
            "entry": "Battle_ClearStage",
            "option": [
                "刷关次数",
                "使用双倍券"
            ]
        }
    ],
    "option": {
        // ────────────── 启动 ──────────────
        // max_hit = 秒数 ÷ 2：启动循环里 post_delay 是 2000ms。
        // 两次尝试各有一个独立的计数节点（理由见 entry.json 的 App_BootCycle doc：
        // max_hit 是整条任务范围的，重启游戏不会清零），所以这里要一起覆盖。
        "启动超时": {
            "type": "select",
            "description": "等待游戏进入大厅的时限。\n\n超时会强停游戏、重新拉起再等一轮；第二次仍超时就放弃、继续往下走。\n网络差或游戏启动慢的时候调大。",
            "default_case": "120秒",
            "cases": [
                {
                    "name": "60秒",
                    "pipeline_override": {
                        "App_BootCount": {
                            "max_hit": 30
                        },
                        "App_BootCount2": {
                            "max_hit": 30
                        }
                    }
                },
                {
                    "name": "120秒",
                    "pipeline_override": {
                        "App_BootCount": {
                            "max_hit": 60
                        },
                        "App_BootCount2": {
                            "max_hit": 60
                        }
                    }
                },
                {
                    "name": "180秒",
                    "pipeline_override": {
                        "App_BootCount": {
                            "max_hit": 90
                        },
                        "App_BootCount2": {
                            "max_hit": 90
                        }
                    }
                },
                {
                    "name": "300秒",
                    "pipeline_override": {
                        "App_BootCount": {
                            "max_hit": 150
                        },
                        "App_BootCount2": {
                            "max_hit": 150
                        }
                    }
                }
            ]
        },
        // ────────────── 邮件 ──────────────
        "邮件领取": {
            "type": "switch",
            "description": "领取邮件附件，点「一键领取」。\n不会触碰旁边的「一键删除」。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    // 子配置项：选中 Yes 时才会在界面上出现。
                    // 定义仍放在本文件外层的 option 里（schema 要求），这里只列名字。
                    "option": [
                        "不领取体力邮件"
                    ],
                    "pipeline_override": {
                        "Daily_Mail": {
                            "next": [
                                "Mail_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Mail": {
                            "next": [
                                "Daily_Summon"
                            ]
                        }
                    }
                }
            ]
        },
        // ⚠️ 这是个**负向开关**（「不领取」），语义与其它开关相反。
        // 之所以反过来写：体力领取是唯一一个「领了反而亏」的邮件操作 ——
        // 账号体力长期溢出（实测 2050/204），领了直接浪费。
        // 做成默认打开的正向「领取体力邮件」会诱导用户打开它。
        "不领取体力邮件": {
            "type": "switch",
            "description": "打开（默认）：跳过「体力领取」，只收附件。\n关闭：连体力一起领。\n\n⚡ 账号体力长期溢出，领了就是浪费。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Mail_ClaimStamina": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Mail_ClaimStamina": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        // ────────────── 使魔探险 ──────────────
        "使魔探险": {
            "type": "switch",
            "description": "每日任务「星辰的彼方」。\n领取已完成的探险奖励，并把已接取数补满。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_Summon": {
                            "next": [
                                "Summon_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Summon": {
                            "next": [
                                "Presence_SummonLove_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        // ────────────── 存在感：战斗类 ──────────────
        "使魔的爱": {
            "type": "switch",
            "description": "每日任务「火线救援」。\n\n流程：战斗 → 活动 → 多元裂缝 → 使魔的爱 → 快捷战斗 → 确定。\n\n⚡ 消耗体力 30。今天打过之后脚本会自动跳过，不会重复消耗。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_SummonLove_Gate": {
                            "next": [
                                "Presence_SummonLove_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_SummonLove_Gate": {
                            "next": [
                                "Presence_WorldSoBig_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        "世界那么大": {
            "type": "switch",
            // ⚠️ 描述里写明了「本账号目前打不了」——解锁前请不要期待它完成。
            "description": "每日任务「世界这么大」。\n\n流程：战斗 → 活动 → 多元裂缝 → 虚轴之庭 → 出击 → 快捷战斗 → 确定 → 回首页。\n\n需要先在游戏里解锁「快捷战斗」（单关造成 20 亿伤害）。没解锁时会跳过，并记为未完成。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_WorldSoBig_Gate": {
                            "next": [
                                "Presence_WorldSoBig_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_WorldSoBig_Gate": {
                            "next": [
                                "Presence_ZhanLiBuQiang_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        // ────────────── 存在感：消耗类 ──────────────
        "战力补强": {
            "type": "switch",
            "description": "每日任务「战力补强」。\n\n流程：商店 → 礼包商店 → 吼美礼包 → 下滑 → 零时馈礼 → 购买 → 确定。\n\n✅ 买的是标价 ×0 的「零时馈礼」—— 不花钱、不消耗任何资源，只占掉当天的限购次数。\n同一页的付费礼包不会点到。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_ZhanLiBuQiang_Gate": {
                            "next": [
                                "Presence_ZhanLiBuQiang_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_ZhanLiBuQiang_Gate": {
                            "next": [
                                "Daily_Stamina"
                            ]
                        }
                    }
                }
            ]
        },
        "共鸣之力": {
            "type": "switch",
            "description": "每日任务「共鸣之力」。\n\n流程：商店 → 崩坏屋 → 共鸣屋 → 点刷新 → 确定。\n\n⚡ 免费刷新次数用完后会消耗「零时之种」，所以默认关闭。\n有免费次数时永远走免费刷新，不会消耗任何东西。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    // 子配置项：只有「共鸣之力」打开时才显示。
                    "option": [
                        "使用代币刷新"
                    ],
                    "pipeline_override": {
                        "Presence_Resonance_Gate": {
                            "next": [
                                "Presence_Resonance_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_Resonance_Gate": {
                            "next": [
                                "Daily_ClaimRewards"
                            ]
                        }
                    }
                }
            ]
        },
        // 「共鸣之力」的子选项：剩余次数归零后，要不要花零时之种继续刷。
        "使用代币刷新": {
            "type": "switch",
            "description": "只在免费刷新次数用完时起作用。\n\n关闭（默认）：没有免费次数就不刷新。\n打开：花「零时之种」继续刷新。\n\n⚡ 零时之种是有限资源。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_Resonance_TokenGate": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_Resonance_TokenGate": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        // ────────────── 体力消耗 ──────────────
        "体力消耗": {
            "type": "switch",
            "description": "刷关卡累计消耗体力，一次做完「千锤百炼 / 勤劳的魔女 / 精益求精」三条任务。\n\n⭐ 消耗体力。刷几次由「体力目标」自动折算，不用手填。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    // 子配置项：只有打开「体力消耗」时才显示。
                    //   关卡来源 → 预设关卡   选刷哪个关卡
                    //   体力目标             累计消耗的体力目标
                    //
                    // ⚠️ 这里**故意不列**「刷关次数」—— 体力消耗的次数是**自动折算**的：
                    // Stamina_Plan 读关卡详情页的「消耗体力 N」，用体力目标除它，再在
                    // **运行时** override_pipeline 改写 Battle_ClearStage_Count.max_hit。
                    //
                    // 运行时改写发生在界面 override **之后**，所以这里就算列了也会被盖掉，
                    // 只会让人以为能手动覆盖。2026-09-20 用户指出后去掉。
                    //
                    // 「刷关次数」只对「通用通关」有意义 —— 那条路没有折算，次数只能手填。
                    "option": [
                        "关卡来源",
                        "体力目标"
                    ],
                    "pipeline_override": {
                        "Daily_Stamina": {
                            "next": [
                                "Stamina_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Stamina": {
                            "next": [
                                "Presence_Resonance_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        // 「体力消耗」的两个子选项：先选用哪种关卡来源，预设时再选具体关卡。
        // 自定义关卡只是占位 —— 内容待补。
        "关卡来源": {
            "type": "switch",
            "description": "体力消耗去刷哪个关卡。\n\n预设关卡：从下面的列表里选一个。\n自定义关卡：⬜ 尚未实现。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    // case 也支持 label —— 用 Yes/No 之外的词让界面更直白
                    "label": "预设关卡",
                    "option": [
                        "预设关卡"
                    ]
                },
                {
                    "name": "No",
                    "label": "自定义关卡（未实现）"
                }
            ]
        },
        // 预设关卡列表。每条 case 干两件事：
        //   1. Stamina_Entry.next 指向该关卡的**专属入场链**（导航归那条链管）
        //   2. 给 Battle_PickStage 灌该关卡的**名称和位置**（它在共享的战斗链里）
        // 加一个新关卡 = 复制一份入场链 + 在这里加一条 case。
        "预设关卡": {
            "type": "select",
            "description": "要刷的关卡。脚本会自动导航过去，然后重复刷。",
            "default_case": "喵王の福利",
            "cases": [
                {
                    "name": "喵王の福利",
                    // 这个 case 做两件事：
                    //   1. 选走哪条入场链（Stamina_Entry.next）——
                    //      导航归那条链管，因为不同关卡的进法不一样
                    //   2. 给 Battle_PickStage 灌**名称和位置** ——
                    //      它在共享的通用通关脚本里，那条链不认识具体关卡，
                    //      所以「刷第二次以上时重新点开关卡」要用的参数只能从这里进
                    //      （首次进关的参数在上面那条入场链里，不用这里管）
                    "pipeline_override": {
                        // 选这个关卡 = 走它自己的入场链（导航也归那条链管 ——
                        // 喵王在曜日挑战页，别处的关卡进法不一样）
                        "Stamina_Entry": {
                            "next": [
                                "Stamina_MiaoWang"
                            ]
                        },
                        "Battle_PickStage": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "喵王の福利"
                                    ]
                                }
                            },
                            "action": {
                                "param": {
                                    "target": [
                                        640,
                                        305
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "体力目标": {
            "type": "select",
            "description": "累计消耗体力的目标值。300 可以一次做完三条累计任务。",
            "default_case": "300",
            "cases": [
                {
                    "name": "180",
                    "pipeline_override": {
                        "Stamina_Plan": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "target_stamina": 180
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "200",
                    "pipeline_override": {
                        "Stamina_Plan": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "target_stamina": 200
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "300",
                    "pipeline_override": {
                        "Stamina_Plan": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "target_stamina": 300
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        // ────────────── 收尾 ──────────────
        "领取以上任务奖励": {
            "type": "switch",
            "description": "收尾：回存在感页，把这一轮新解锁的里程碑奖励领掉。\n\n排在体力消耗之后，这样体力消耗产生的存在感也一起收进来。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_ClaimRewards": {
                            "next": [
                                "ClaimRewards_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_ClaimRewards": {
                            "next": [
                                "Daily_Weekly"
                            ]
                        }
                    }
                }
            ]
        },
        "每周任务": {
            "type": "switch",
            "description": "执行每周存在感任务。\n⬜ 尚未实现。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_Weekly": {
                            "next": [
                                "Weekly_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Weekly": {
                            "next": [
                                "Daily_Finish"
                            ]
                        }
                    }
                }
            ]
        },
        // ────────────── 通用通关专用 ──────────────
        "使用双倍券": {
            "type": "switch",
            "description": "⚡ 进入关卡时勾选「使用双倍券」—— 双倍消耗换双倍奖励，而且券是消耗品，所以默认关闭。",
            "default_case": "No",
