{
    // ════════════════════════════════════════════════════════════════
    //  BBHelper — 崩坏学园2 日常清理脚本
    //
    //  坐标系：1280×720 横屏（短边即 720）
    //  连接方式：MuMu 模拟器走 ADB。⚠️ 用 Win32 窗口方式连接会黑屏。
    //  游戏包名：com.miHoYo.HSoDv2Original（官服）
    //
    //  ⚠️ 安全约定（主号）：
    //    本脚本对「消耗资源 / 不可逆」的操作一律**默认关闭**，
    //    需要用户在界面上显式打开对应开关才会执行。
    //    详见各 option 的 description。
    // ════════════════════════════════════════════════════════════════
    "interface_version": 2,
    "name": "BBHelper",
    "description": "崩坏学园2 日常清理：每日签到、邮件领取、存在感每日任务、使魔探险、每周任务。",
    "contact": "",
    "license": "MIT",
    "welcome": "使用前请确认：\n1. 游戏已在 MuMu 模拟器中运行并登录\n2. 模拟器分辨率保持 1280×720 横屏\n3. 用 ADB 方式连接，不要用 Win32 窗口方式（会黑屏）",
    "github": "",
    "version": "0.1.0",
    "controller": [
        {
            "name": "MuMu 模拟器（ADB）",
            "type": "Adb",
            // 横屏 1280×720，短边即 720
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // ════════════════════════════════════════════════════════════════
    //  Agent 配置 —— 开发期**必须保持注释状态**，不要取消注释。
    //
    //  Maa Pipeline Support 插件的行为（源码 `buildRuntime`）：
    //      result.agent = [];
    //      for (const agent of agents) {
    //          if (!agent.child_exec) continue;   // 没填 child_exec 就整个跳过
    //          ...
    //      }
    //  也就是说：**不填 agent 块时，插件走自己的机制**（VS Code 的 `maa-launch`
    //  debug session，用你选定的 Python 解释器启动 AgentServer），本来就能用。
    //  一旦填了 child_exec，反而会被拽去「用终端命令启动」那条路 —— 那条路依赖
    //  系统 PATH 上有可用的 python，本机没有，于是连环报
    //  「Python was not found」/「No module named 'maa'」。
    //
    //  ⚠️ 但**发布产物需要这个块**：MFAAvalonia 靠它启动 AgentServer，
    //     否则所有 CustomRecognition / CustomAction 节点都会失效。
    //     所以由 tools/install.py 在打包时写入（见该脚本的 install_resource）。
    //
    //  发布期形态（供参考，不要手工启用）：
    //      "agent": { "child_exec": "python", "child_args": ["./agent/main.py"] }
    // ════════════════════════════════════════════════════════════════
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "日常清理",
            "entry": "Daily_CleanUp",
            "option": [
                "邮件领取",
                "领取体力邮件",
                "使魔探险",
                "战斗类每日",
                "购物类每日",
                "共鸣屋刷新",
                "体力消耗循环",
                "体力目标",
                "每周任务"
            ]
        },
        {
            "name": "仅领邮件",
            "entry": "Mail_Entry",
            "option": [
                "邮件领取",
                "领取体力邮件"
            ]
        },
        {
            "name": "仅使魔探险",
            "entry": "Summon_Entry"
        },
        {
            "name": "启动游戏并回大厅",
            "entry": "App_Launch"
        },
        {
            "name": "通用通关（需先停在关卡详情页）",
            "entry": "Battle_ClearStage",
            "option": [
                "刷关次数",
                "使用双倍券"
            ]
        }
    ],
    "option": {
        "邮件领取": {
            "type": "switch",
            "description": "领取邮件附件（点「一键领取」）。不会触碰「一键删除」。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Mail_Entry": {
                            "next": [
                                "Mail_Loop",
                                "Mail_Nav"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Mail_Entry": {
                            "next": [
                                "Mail_PhaseDone"
                            ]
                        }
                    }
                }
            ]
        },
        "领取体力邮件": {
            "type": "switch",
            "description": "领取邮件里的体力。⚠️ 若体力已溢出（如 1975/204），领取会直接浪费，故默认关闭。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Mail_ClaimStamina": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Mail_ClaimStamina": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "使魔探险": {
            "type": "switch",
            "description": "领取已完成（「探索完成」）的探险奖励，并把已接取数补到上限。对应每日任务「星辰的彼方」。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Summon_Entry": {
                            "next": [
                                "Summon_PhaseDone"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Summon_Entry": {
                            "next": [
                                "Summon_PhaseDone"
                            ]
                        }
                    }
                }
            ]
        },
        "战斗类每日": {
            "type": "switch",
            "description": "火线救援（使魔的爱）、世界这么大（虚轴之庭）。走「快捷战斗」秒过，会消耗体力。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_CombatTask_Gate": {
                            "next": [
                                "Presence_Evaluate"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_CombatTask_Gate": {
                            "next": [
                                "Presence_Evaluate"
                            ]
                        }
                    }
                }
            ]
        },
        "购物类每日": {
            "type": "switch",
            "description": "⚡ 战力补强：购买一件「礼包商店」商品，会**真实消费**。默认关闭。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_ShopPurchase_Gate": {
                            "next": [
                                "Presence_Evaluate"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_ShopPurchase_Gate": {
                            "next": [
                                "Presence_Evaluate"
                            ]
                        }
                    }
                }
            ]
        },
        "共鸣屋刷新": {
            "type": "switch",
            "description": "⚡ 共鸣之力：刷新一次「共鸣屋」商品，可能消耗水晶。默认关闭。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_Resonance_Gate": {
                            "next": [
                                "Presence_Evaluate"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_Resonance_Gate": {
                            "next": [
                                "Presence_Evaluate"
                            ]
                        }
                    }
                }
            ]
        },
        "体力消耗循环": {
            "type": "switch",
            "description": "刷关卡累计消耗体力，一次性完成「千锤百炼 / 勤劳的魔女 / 精益求精」三条。会消耗体力。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_Stamina": {
                            "next": [
                                "Stamina_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Stamina": {
                            "next": [
                                "Daily_Weekly"
                            ]
                        }
                    }
                }
            ]
        },
        "体力目标": {
            "type": "select",
            "description": "累计消耗体力的目标值。300 可一次完成三条累计任务。",
            "default_case": "300",
            "cases": [
                {
                    "name": "180",
                    "pipeline_override": {
                        "Stamina_Plan": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "target_stamina": 180
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "200",
                    "pipeline_override": {
                        "Stamina_Plan": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "target_stamina": 200
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "300",
                    "pipeline_override": {
                        "Stamina_Plan": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "target_stamina": 300
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "每周任务": {
            "type": "switch",
            "description": "执行每周存在感任务（满分 550）。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_Weekly": {
                            "next": [
                                "Weekly_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Weekly": {
                            "next": [
                                "Daily_Finish"
                            ]
                        }
                    }
                }
            ]
        },
        "使用双倍券": {
            "type": "switch",
            "description": "⚡ 进入关卡时勾选「使用双倍券」。⚠️ 双倍券是**双倍消耗换双倍奖励**（实测：标称消耗 10 的关卡用了之后扣 20 体力），且是消耗品，所以默认关闭。\n\n开启后**关头关尾都会勾**：关卡详情页的复选框，以及 BONUS 关卡结算界面上的复选框（后者用于「再次挑战」的下一轮）。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Battle_ResultTicket": {
                            "enabled": true
                        },
                        "Battle_DetailTicket": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Battle_ResultTicket": {
                            "enabled": false
                        },
                        "Battle_DetailTicket": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "刷关次数": {
            "type": "input",
            "description": "同一个关卡连续刷几次。1 = 只刷一遍。\n\n刷完最后一轮后脚本会点结算面板的「确定」收尾。\n\n⚠️ 带「再次挑战」按钮的关卡（BONUS）会直接从结算界面续关；普通关卡则要走「确定 → 回关卡列表 → 重新点开关卡」，那条路径依赖 `Battle_PickStage` 里写死的关卡，换关卡时需要一并修改（见该节点 doc）。",
            "inputs": [
                {
                    "name": "次数",
                    "label": "刷关次数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "Battle_ClearStage_Count": {
                    "max_hit": "{次数}"
                }
            }
        }
    }
}