{
    // ════════════════════════════════════════════════════════════════
    //  BBHelper — 崩坏学园2 日常清理脚本
    //
    //  坐标系：1280×720 横屏（短边即 720）
    //  连接方式：MuMu 模拟器走 ADB。⚠️ 用 Win32 窗口方式连接会黑屏。
    //  游戏包名：com.miHoYo.HSoDv2Original（官服）
    //
    //  ⚠️ 安全约定（主号）：
    //    本脚本对「消耗资源 / 不可逆」的操作一律**默认关闭**，
    //    需要用户在界面上显式打开对应开关才会执行。
    //    带 ⚡ 标记的选项即属此类。详见各 option 的 description。
    //
    //  开关的实现方式：每个 option 的 pipeline_override 改写一个
    //  「切点」节点的 next —— Yes 指向任务节点，No 指向下一个切点。
    //  切点本身只做路由（DirectHit + DoNothing），不含业务逻辑。
    //  因此 **pipeline 里的默认 next = 本文件的 default_case**，两边必须一致。
    // ════════════════════════════════════════════════════════════════
    "interface_version": 2,
    "name": "BBHelper",
    "description": "崩坏学园2 日常清理：邮件领取、使魔探险、存在感每日任务（使魔的爱 / 世界那么大 / 战力补强 / 共鸣之力 / 体力消耗）、收尾领奖、每周任务。",
    "contact": "",
    "license": "MIT",
    "welcome": "使用前请确认：\n1. 游戏已在 MuMu 模拟器中运行并登录\n2. 模拟器分辨率保持 1280×720 横屏\n3. 用 ADB 方式连接，不要用 Win32 窗口方式（会黑屏）",
    "github": "",
    "version": "0.1.0",
    "controller": [
        {
            "name": "MuMu 模拟器（ADB）",
            "type": "Adb",
            // 横屏 1280×720，短边即 720
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // ════════════════════════════════════════════════════════════════
    //  Agent 配置 —— 开发期**必须保持注释状态**，不要取消注释。
    //
    //  Maa Pipeline Support 插件的行为（源码 `buildRuntime`）：
    //      result.agent = [];
    //      for (const agent of agents) {
    //          if (!agent.child_exec) continue;   // 没填 child_exec 就整个跳过
    //          ...
    //      }
    //  也就是说：**不填 agent 块时，插件走自己的机制**（VS Code 的 `maa-launch`
    //  debug session，用你选定的 Python 解释器启动 AgentServer），本来就能用。
    //  一旦填了 child_exec，反而会被拽去「用终端命令启动」那条路 —— 那条路依赖
    //  系统 PATH 上有可用的 python，本机没有，于是连环报
    //  「Python was not found」/「No module named 'maa'」。
    //
    //  ⚠️ 但**发布产物需要这个块**：MFAAvalonia 靠它启动 AgentServer，
    //     否则所有 CustomRecognition / CustomAction 节点都会失效。
    //     所以由 tools/install.py 在打包时写入（见该脚本的 install_resource）。
    //
    //  发布期形态（供参考，不要手工启用）：
    //      "agent": { "child_exec": "python", "child_args": ["./agent/main.py"] }
    // ════════════════════════════════════════════════════════════════
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "日常清理",
            "entry": "Daily_CleanUp",
            // 顺序 = 管线里的阶段顺序，见 entry.json 的 Daily_CleanUp。
            "option": [
                "邮件领取",
                "使魔探险",
                "使魔的爱",
                "世界那么大",
                "战力补强",
                "体力消耗",
                "体力目标",
                "共鸣之力",
                "领取以上任务奖励",
                "每周任务"
            ]
        },
        {
            "name": "仅领邮件",
            "entry": "Mail_Entry",
            // 这个任务本身就是「领邮件」，所以不列「邮件领取」开关
            // （那个开关改的是 Daily_Mail 切点，不在本任务的链上）。
            // 「不领取体力邮件」直接列在这里：子配置项本身也定义在外层 option 里，
            // 既能挂在「邮件领取 → Yes」下面，也能被任务直接引用。
            "option": [
                "不领取体力邮件"
            ]
        },
        {
            "name": "仅使魔探险",
            "entry": "Summon_Entry"
        },
        {
            "name": "启动游戏并回大厅",
            "entry": "App_Launch"
        },
        {
            "name": "通用通关（需先停在关卡详情页）",
            "entry": "Battle_ClearStage",
            "option": [
                "刷关次数",
                "使用双倍券"
            ]
        }
    ],
    "option": {
        // ────────────── 邮件 ──────────────
        "邮件领取": {
            "type": "switch",
            "description": "领取邮件附件（点「一键领取」）。不会触碰「一键删除」。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    // 子配置项：选中 Yes 时才会在界面上出现。
                    // 定义仍放在本文件外层的 option 里（schema 要求），这里只列名字。
                    "option": [
                        "不领取体力邮件"
                    ],
                    "pipeline_override": {
                        "Daily_Mail": {
                            "next": [
                                "Mail_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Mail": {
                            "next": [
                                "Daily_Summon"
                            ]
                        }
                    }
                }
            ]
        },
        // ⚠️ 这是个**负向开关**（「不领取」），语义与其它开关相反。
        // 之所以反过来写：体力领取是唯一一个「领了反而亏」的邮件操作 ——
        // 账号体力长期溢出（实测 2050/204），领了直接浪费。
        // 做成默认打开的正向「领取体力邮件」会诱导用户打开它。
        "不领取体力邮件": {
            "type": "switch",
            "description": "**打开（默认）** = 跳过「体力领取」按钮，只收附件。\n**关闭** = 连体力一起领。\n\n⚡ 体力领取与其它邮件操作相反：账号体力长期溢出（实测 2050/204），领了直接**浪费**，所以这里写成「不领取」并默认打开。\n\n只在「邮件领取」打开时才会显示（它是那个开关的子项）。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Mail_ClaimStamina": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Mail_ClaimStamina": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        // ────────────── 使魔探险 ──────────────
        "使魔探险": {
            "type": "switch",
            "description": "每日任务「星辰的彼方」：派遣或收回一次使魔探险。\n\n领取已完成（「探索完成」）的探险奖励，并把已接取数补到上限。领取即算「收回」，所以默认开。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_Summon": {
                            "next": [
                                "Summon_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Summon": {
                            "next": [
                                "Presence_SummonLove_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        // ────────────── 存在感：战斗类 ──────────────
        "使魔的爱": {
            "type": "switch",
            "description": "每日任务「火线救援」：通过一次多元裂缝关卡「使魔的爱」。\n\n⭐ 消耗体力 30。走「快捷战斗」秒过，不进战斗。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_SummonLove_Gate": {
                            "next": [
                                "Presence_SummonLove_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_SummonLove_Gate": {
                            "next": [
                                "Presence_WorldSoBig_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        "世界那么大": {
            "type": "switch",
            "description": "每日任务「世界这么大」：挑战一次「虚轴之庭」的任意关卡。\n\n⭐ 消耗体力。虚轴之庭在活动标签右侧滚动栏的「多元裂缝」里。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_WorldSoBig_Gate": {
                            "next": [
                                "Presence_WorldSoBig_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_WorldSoBig_Gate": {
                            "next": [
                                "Presence_ZhanLiBuQiang_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        // ────────────── 存在感：消耗类 ──────────────
        "战力补强": {
            "type": "switch",
            "description": "每日任务「战力补强」：购买一件「礼包商店」中的商品。\n\n⚡ **真实消费**，不可逆，所以默认关闭。\n⬜ 尚未实现：购买逻辑需要现场引导确认商品与价格，当前打开开关也不会有动作。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_ZhanLiBuQiang_Gate": {
                            "next": [
                                "Presence_ZhanLiBuQiang_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_ZhanLiBuQiang_Gate": {
                            "next": [
                                "Daily_Stamina"
                            ]
                        }
                    }
                }
            ]
        },
        "共鸣之力": {
            "type": "switch",
            "description": "每日任务「共鸣之力」：刷新一次「共鸣屋」中的商品。\n\n⚡ 刷新可能消耗水晶，所以默认关闭。\n⬜ 尚未实现：当前打开开关也不会有动作。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_Resonance_Gate": {
                            "next": [
                                "Presence_Resonance_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_Resonance_Gate": {
                            "next": [
                                "Daily_ClaimRewards"
                            ]
                        }
                    }
                }
            ]
        },
        // ────────────── 体力消耗 ──────────────
        "体力消耗": {
            "type": "switch",
            "description": "刷关卡累计消耗体力，一次性完成「千锤百炼（200） / 勤劳的魔女（180） / 精益求精（300）」三条。\n\n⭐ 消耗体力。刷满 300 即可同时完成三条。\n⬜ 尚未实现：还没确定哪个关卡可重复刷，当前是空壳。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_Stamina": {
                            "next": [
                                "Stamina_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Stamina": {
                            "next": [
                                "Presence_Resonance_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        "体力目标": {
            "type": "select",
            "description": "累计消耗体力的目标值。300 可一次完成三条累计任务。",
            "default_case": "300",
            "cases": [
                {
                    "name": "180",
                    "pipeline_override": {
                        "Stamina_Plan": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "target_stamina": 180
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "200",
                    "pipeline_override": {
                        "Stamina_Plan": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "target_stamina": 200
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "300",
                    "pipeline_override": {
                        "Stamina_Plan": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "target_stamina": 300
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        // ────────────── 收尾 ──────────────
        "领取以上任务奖励": {
            "type": "switch",
            "description": "跑完上面所有任务后回存在感页收尾，把这一轮新解锁的奖励领掉（里程碑星星 20/40/60/80/100/150 的「一键领取」）。\n\n排在体力消耗**之后**，这样体力消耗产生的存在感也一起收进来。\n\n✅ 已接上真实节点（导航 + 一键领取 + 关弹窗），节点本身此前实机验证过。⚠️ 但它从「存在感阶段入口」挪到「收尾链」之后的新位置**尚未实机验证**。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_ClaimRewards": {
                            "next": [
                                "ClaimRewards_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_ClaimRewards": {
                            "next": [
                                "Daily_Weekly"
                            ]
                        }
                    }
                }
            ]
        },
        "每周任务": {
            "type": "switch",
            "description": "执行每周存在感任务（满分 550）。\n⬜ 尚未实现：当前是直通骨架。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_Weekly": {
                            "next": [
                                "Weekly_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Weekly": {
                            "next": [
                                "Daily_Finish"
                            ]
                        }
                    }
                }
            ]
        },
        // ────────────── 通用通关专用 ──────────────
        "使用双倍券": {
            "type": "switch",
            "description": "⚡ 进入关卡时勾选「使用双倍券」。⚠️ 双倍券是**双倍消耗换双倍奖励**（实测：标称消耗 10 的关卡用了之后扣 20 体力），且是消耗品，所以默认关闭。\n\n开启后**关头关尾都会勾**：关卡详情页的复选框，以及 BONUS 关卡结算界面上的复选框（后者用于「再次挑战」的下一轮）。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Battle_ResultTicket": {
                            "enabled": true
                        },
                        "Battle_DetailTicket": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Battle_ResultTicket": {
                            "enabled": false
                        },
                        "Battle_DetailTicket": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "刷关次数": {
            "type": "input",
            "description": "同一个关卡连续刷几次。1 = 只刷一遍。\n\n刷完最后一轮后脚本会点结算面板的「确定」收尾。\n\n⚠️ 带「再次挑战」按钮的关卡（BONUS）会直接从结算界面续关；普通关卡则要走「确定 → 回关卡列表 → 重新点开关卡」，那条路径依赖 `Battle_PickStage` 里写死的关卡，换关卡时需要一并修改（见该节点 doc）。",
            "inputs": [
                {
                    "name": "次数",
                    "label": "刷关次数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "Battle_ClearStage_Count": {
                    "max_hit": "{次数}"
                }
            }
        }
    }
}
