{
    // ════════════════════════════════════════════════════════════════
    //  BBHelper — 崩坏学园2 日常清理脚本
    //
    //  坐标系：1280×720 横屏（短边即 720）
    //  连接方式：MuMu 模拟器走 ADB。⚠️ 用 Win32 窗口方式连接会黑屏。
    //  游戏包名：com.miHoYo.HSoDv2Original（官服）
    //
    //  ⚠️ 安全约定（主号）：
    //    本脚本对「消耗资源 / 不可逆」的操作一律**默认关闭**，
    //    需要用户在界面上显式打开对应开关才会执行。
    //    带 ⚡ 标记的选项即属此类。详见各 option 的 description。
    //
    //  开关的实现方式：每个 option 的 pipeline_override 改写一个
    //  「切点」节点的 next —— Yes 指向任务节点，No 指向下一个切点。
    //  切点本身只做路由（DirectHit + DoNothing），不含业务逻辑。
    //  因此 **pipeline 里的默认 next = 本文件的 default_case**，两边必须一致。
    // ════════════════════════════════════════════════════════════════
    "interface_version": 2,
    "name": "BBHelper",
    "description": "崩坏学园2 日常清理：邮件领取、使魔探险、存在感每日任务（使魔的爱 / 世界那么大 / 战力补强 / 共鸣之力 / 体力消耗）、收尾领奖、每周任务。",
    "contact": "",
    "license": "MIT",
    "welcome": "使用前请确认：\n1. 游戏已在 MuMu 模拟器中运行并登录\n2. 模拟器分辨率保持 1280×720 横屏\n3. 用 ADB 方式连接，不要用 Win32 窗口方式（会黑屏）",
    "github": "",
    "version": "0.1.0",
    "controller": [
        {
            "name": "MuMu 模拟器（ADB）",
            "type": "Adb",
            // 横屏 1280×720，短边即 720
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // ════════════════════════════════════════════════════════════════
    //  Agent 配置 —— **必须填，否则所有 Custom* 节点失效**。
    //
    //  ⚠️ 本块曾经被误注释掉过（"不填插件也能用"），那是**错的**：
    //     2026-09-19 实测，注释掉之后跑日常会在第一个 Custom 节点上直接失败：
    //         [ERR][CustomAction.cpp] Action is null [param.name=phase_begin]
    //         Task.Failed
    //     当时只验证了"插件不报错"，没验证 Custom 节点能不能跑。
    //
    //  插件的真实逻辑（源码 buildRuntime + AgentClient）：
    //      const debug_session = debugSessionMapper[agent.child_exec];
    //      if (agentConfig.debug_session) { startDebugSession(...) }   // 走调试器
    //      else if (agentConfig.child_exec) { startTask(child_exec, args) }  // 当终端命令跑
    //  也就是说 child_exec 既是「可执行文件」又是「调试会话的查找键」。
    //  本机没有系统 python，走不了也不能走终端那条路，所以这里直接用
    //  **项目 venv 的 python 全路径**，让它以普通子进程方式启动。
    //
    //  路径变量：插件只认 `{PROJECT_DIR}`（单花括号，不是 ${}）。
    //  ⚠️ 它不是项目根，而是**interface.json 所在目录**（= assets/）：
    //      const projectDir = joinPath(activeResource.workspace, activeResource.dirRelative)
    //  所以下面两个路径都要 `../` 退一级才回到项目根。
    //
    //  child_args 末尾插件会自动追加 <identifier>，正好对上 main.py 的 argv[-1]。
    //
    //  ⚠️ 这也解释了开发早期那次「Python was not found」的怪事：
    //     当时写的是 "./agent/main.py"（相对 assets/），而 assets/agent/ 那时
    //     还躺着一份**陈旧副本** —— 插件跑的是它，所以 Custom 节点全找不到。
    //     副本删掉后就变成路径直接不存在了。
    //
    //  ⚠️ 发布产物由 tools/install.py 另行写入（那边 agent/ 与 interface.json
    //     平级，路径形态不同），不要指望这一块被直接带过去。
    // ════════════════════════════════════════════════════════════════
    "agent": {
        "child_exec": "{PROJECT_DIR}/../.venv/Scripts/python.exe",
        "child_args": [
            "{PROJECT_DIR}/../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "日常清理",
            "entry": "Daily_CleanUp",
            // 顺序 = 管线里的阶段顺序，见 entry.json 的 Daily_CleanUp。
            "option": [
                "启动超时",
                "邮件领取",
                "使魔探险",
                "使魔的爱",
                "世界那么大",
                "战力补强",
                // 体力消耗的子项（关卡来源 → 预设关卡、体力目标）不在这里列 ——
                // 它们挂在「体力消耗 → Yes」的 option 里，选中时才显示。
                "体力消耗",
                "共鸣之力",
                "领取以上任务奖励",
                "每周任务"
            ]
        },
        {
            "name": "仅领邮件",
            "entry": "Mail_Entry",
            // 这个任务本身就是「领邮件」，所以不列「邮件领取」开关
            // （那个开关改的是 Daily_Mail 切点，不在本任务的链上）。
            // 「不领取体力邮件」直接列在这里：子配置项本身也定义在外层 option 里，
            // 既能挂在「邮件领取 → Yes」下面，也能被任务直接引用。
            "option": [
                "不领取体力邮件"
            ]
        },
        {
            "name": "仅使魔探险",
            "entry": "Summon_Entry"
        },
        {
            "name": "通用通关（需先停在关卡详情页）",
            "entry": "Battle_ClearStage",
            "option": [
                "刷关次数",
                "使用双倍券"
            ]
        }
    ],
    "option": {
        // ────────────── 启动 ──────────────
        // max_hit = 秒数 ÷ 2：启动循环里 post_delay 是 2000ms。
        // 两次尝试各有一个独立的计数节点（理由见 entry.json 的 App_BootCycle doc：
        // max_hit 是整条任务范围的，重启游戏不会清零），所以这里要一起覆盖。
        "启动超时": {
            "type": "select",
            "description": "**等待进入大厅的时限**（两次尝试各算一次）。\n\n超时会**强停游戏并重新拉起**再等一轮（只重启一次，避免无限重试拖垮模拟器）；第二次还是超时就放弃、硬着头皮继续往下走。\n\n网络差、或游戏启动慢的时候调大。",
            "default_case": "120秒",
            "cases": [
                {
                    "name": "60秒",
                    "pipeline_override": {
                        "App_BootCount": {
                            "max_hit": 30
                        },
                        "App_BootCount2": {
                            "max_hit": 30
                        }
                    }
                },
                {
                    "name": "120秒",
                    "pipeline_override": {
                        "App_BootCount": {
                            "max_hit": 60
                        },
                        "App_BootCount2": {
                            "max_hit": 60
                        }
                    }
                },
                {
                    "name": "180秒",
                    "pipeline_override": {
                        "App_BootCount": {
                            "max_hit": 90
                        },
                        "App_BootCount2": {
                            "max_hit": 90
                        }
                    }
                },
                {
                    "name": "300秒",
                    "pipeline_override": {
                        "App_BootCount": {
                            "max_hit": 150
                        },
                        "App_BootCount2": {
                            "max_hit": 150
                        }
                    }
                }
            ]
        },
        // ────────────── 邮件 ──────────────
        "邮件领取": {
            "type": "switch",
            "description": "领取邮件附件（点「一键领取」）。不会触碰「一键删除」。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    // 子配置项：选中 Yes 时才会在界面上出现。
                    // 定义仍放在本文件外层的 option 里（schema 要求），这里只列名字。
                    "option": [
                        "不领取体力邮件"
                    ],
                    "pipeline_override": {
                        "Daily_Mail": {
                            "next": [
                                "Mail_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Mail": {
                            "next": [
                                "Daily_Summon"
                            ]
                        }
                    }
                }
            ]
        },
        // ⚠️ 这是个**负向开关**（「不领取」），语义与其它开关相反。
        // 之所以反过来写：体力领取是唯一一个「领了反而亏」的邮件操作 ——
        // 账号体力长期溢出（实测 2050/204），领了直接浪费。
        // 做成默认打开的正向「领取体力邮件」会诱导用户打开它。
        "不领取体力邮件": {
            "type": "switch",
            "description": "**打开（默认）** = 跳过「体力领取」按钮，只收附件。\n**关闭** = 连体力一起领。\n\n⚡ 体力领取与其它邮件操作相反：账号体力长期溢出（实测 2050/204），领了直接**浪费**，所以这里写成「不领取」并默认打开。\n\n只在「邮件领取」打开时才会显示（它是那个开关的子项）。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Mail_ClaimStamina": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Mail_ClaimStamina": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        // ────────────── 使魔探险 ──────────────
        "使魔探险": {
            "type": "switch",
            "description": "每日任务「星辰的彼方」：派遣或收回一次使魔探险。\n\n领取已完成（「探索完成」）的探险奖励，并把已接取数补到上限。领取即算「收回」，所以默认开。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_Summon": {
                            "next": [
                                "Summon_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Summon": {
                            "next": [
                                "Presence_SummonLove_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        // ────────────── 存在感：战斗类 ──────────────
        "使魔的爱": {
            "type": "switch",
            "description": "每日任务「火线救援」：通过一次多元裂缝关卡「使魔的爱」。\n\n⭐ 消耗体力 30。走「快捷战斗」秒过，不进战斗。\n\n路径：首页 → 顶部战斗 → 左侧竖栏活动 → 右侧列多元裂缝 → 使魔的爱 → 快捷战斗 → 确定 → 结算确定。\n\n✅ 今天打过之后「快捷战斗」按钮会消失，脚本据此自动跳过，不会重复消耗体力。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_SummonLove_Gate": {
                            "next": [
                                "Presence_SummonLove_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_SummonLove_Gate": {
                            "next": [
                                "Presence_WorldSoBig_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        "世界那么大": {
            "type": "switch",
            // ⚠️ 描述里写明了「本账号目前打不了」——解锁前请不要期待它完成。
            "description": "每日任务「世界这么大」：挑战一次「虚轴之庭」的任意关卡。\n\n路径：首页 → 顶部战斗 → 左侧竖栏活动 → 右列多元裂缝 → 右列虚轴之庭 → 出击 → 快捷战斗 → 确定 → 结算确定 → 回首页。\n\n✅ 全流程已实机验证（2026-09-20）。\n\n⚠️ 虚轴之庭的「快捷战斗」需要**单关造成 20 亿伤害**才解锁。没解锁时按钮是灰的，\n脚本会识别出来、记为 skipped（未完成）并跳过，不会误报成功。\n解锁一次之后永久有效。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_WorldSoBig_Gate": {
                            "next": [
                                "Presence_WorldSoBig_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_WorldSoBig_Gate": {
                            "next": [
                                "Presence_ZhanLiBuQiang_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        // ────────────── 存在感：消耗类 ──────────────
        "战力补强": {
            "type": "switch",
            "description": "每日任务「战力补强」：购买一件「礼包商店」中的商品。\n\n✅ **买的是「零时馈礼」，标价 ×0 —— 不花钱、不消耗任何资源**，只是占掉当天的限购次数。\n\n路径：首页 → 顶部商店 → 礼包商店 → 左侧栏吼美礼包 → 下滑 → 零时馈礼 → 购买 → 确定。\n\n✅ 今天买过之后「零时馈礼」会从列表里消失，脚本据此自动跳过。\n\n⚠️ 同一页的「月卡礼包」是 **￥30 真实货币**，「日常补给包」要 ×6 —— 脚本只认文字定位，\n不会点错到它们，但也**不要改这条链的商品目标**。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_ZhanLiBuQiang_Gate": {
                            "next": [
                                "Presence_ZhanLiBuQiang_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_ZhanLiBuQiang_Gate": {
                            "next": [
                                "Daily_Stamina"
                            ]
                        }
                    }
                }
            ]
        },
        "共鸣之力": {
            "type": "switch",
            "description": "每日任务「共鸣之力」：刷新一次「共鸣屋」中的商品。\n\n⚡ 可能消耗**零时之种**（刷新按钮左边的紫色代币），所以默认关闭。\n\n脚本读刷新按钮左边的「剩余次数 N次」来决定：\n  · N ≥ 1 → 走免费次数，**不消耗任何东西**\n  · N = 0 → 消耗零时之种，此时才看子选项「使用代币刷新」（默认关闭 → **不刷新**）\n\n路径：顶部商店 → 崩坏屋卡片 → 左侧栏共鸣屋 → 「剩余次数」右侧的圆形刷新按钮 → 弹窗确定。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    // 子配置项：只有「共鸣之力」打开时才显示。
                    "option": [
                        "使用代币刷新"
                    ],
                    "pipeline_override": {
                        "Presence_Resonance_Gate": {
                            "next": [
                                "Presence_Resonance_Task"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_Resonance_Gate": {
                            "next": [
                                "Daily_ClaimRewards"
                            ]
                        }
                    }
                }
            ]
        },
        // 「共鸣之力」的子选项：剩余次数归零后，要不要花零时之种继续刷。
        "使用代币刷新": {
            "type": "switch",
            "description": "**只在「剩余次数」归零时起作用。**\n\n**关闭（默认）** = 没有免费次数就不刷新 —— 不消耗零时之种。\n**打开** = 免费次数用完后，花零时之种继续刷新。\n\n⚡ 零时之种是**有限**资源（当前 49 个），所以默认关闭。\n\n有免费次数时本选项无关紧要 —— 那种情况下永远走免费刷新。\n\n只在「共鸣之力」打开时才会显示（它是那个开关的子项）。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Presence_Resonance_TokenGate": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Presence_Resonance_TokenGate": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        // ────────────── 体力消耗 ──────────────
        "体力消耗": {
            "type": "switch",
            "description": "刷关卡累计消耗体力，一次性完成「千锤百炼（200） / 勤劳的魔女（180） / 精益求精（300）」三条。\n\n⭐ 消耗体力。刷满 300 即可同时完成三条。\n⬜ 尚未实现：还没确定哪个关卡可重复刷，当前是空壳。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    // 子配置项：只有打开「体力消耗」时才显示。
                    //   关卡来源 → 预设关卡   选刷哪个关卡
                    //   体力目标             累计消耗的体力目标
                    "option": [
                        "关卡来源",
                        "刷关次数",
                        "体力目标"
                    ],
                    "pipeline_override": {
                        "Daily_Stamina": {
                            "next": [
                                "Stamina_Entry"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Stamina": {
                            "next": [
                                "Presence_Resonance_Gate"
                            ]
                        }
                    }
                }
            ]
        },
        // 「体力消耗」的两个子选项：先选用哪种关卡来源，预设时再选具体关卡。
        // 自定义关卡只是占位 —— 内容待补。
        "关卡来源": {
            "type": "switch",
            "description": "体力消耗去刷哪个关卡。\n\n**预设关卡** = 从下面的「预设关卡」下拉里选一个（目前只有喵王の福利）。\n**自定义关卡** = ⬜ **尚未实现**：内容待补，选它现在不会有任何动作。\n\n只在「体力消耗」打开时才显示。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    // case 也支持 label —— 用 Yes/No 之外的词让界面更直白
                    "label": "预设关卡",
                    "option": [
                        "预设关卡"
                    ]
                },
                {
                    "name": "No",
                    "label": "自定义关卡（未实现）"
                }
            ]
        },
        // 预设关卡列表。每个 case 覆盖 Stamina_PickStage 的**识别文本**和**点击坐标** ——
        // 加一个新关卡 = 在这里加一条，管线不用动。
        "预设关卡": {
            "type": "select",
            "description": "要刷的预设关卡。\n\n选中后脚本会导航到它：战斗 → 活动 → 多元裂缝 → 曜日挑战 → 该关卡。\n\n加新关卡的写法见 `presence.json` 里 `Stamina_PickStage` 的 doc（改 expected 和 target 两个字段）。",
            "default_case": "喵王の福利",
            "cases": [
                {
                    "name": "喵王の福利",
                    // ⚠️ 必须**同时覆盖两个节点** —— 「选关」这件事有两处：
                    //     Stamina_PickStage  首次进关卡
                    //     Battle_PickStage   刷第二次以上时的重新选关
                    // 只改一个的话，第二次开刷会去点旧关卡 ✗
                    "pipeline_override": {
                        // 选这个关卡 = 走它自己的入场链（导航也归那条链管 ——
                        // 喵王在曜日挑战页，别处的关卡进法不一样）
                        "Stamina_Entry": {
                            "next": [
                                "Stamina_MiaoWang"
                            ]
                        },
                        "Battle_PickStage": {
                            "recognition": {
                                "param": {
