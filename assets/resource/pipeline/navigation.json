    "Nav_GotoLobby": {
        "doc": "回大厅。六个顶部标签都是文字，全部走 OCR，不写死坐标；共用同一个大 ROI，靠 expected 唯一性区分。",
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "DoNothing", "param": {} },
        "next": ["Nav_LobbyTab"],
        "max_hit": 5
    },

    "Nav_GotoSocial": {
        "doc": "去社交页。链式降级：本页直接命中 → 否则先回大厅再试。",
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "DoNothing", "param": {} },
        "next": ["Nav_SocialTab", "[JumpBack]Nav_GotoLobby"],
        "max_hit": 5
    },

    "Nav_GotoMail": {
        "doc": "去邮件页。链式降级：本页直接命中 → 否则先去社交页。",
