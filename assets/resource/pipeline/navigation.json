    "Nav_TaskCenterIcon": {
        "doc": "大厅左侧任务中心图标（白色本子）。无文字，只能用 TemplateMatch。模板已剔除右上角通知红点，避免红点出现/消失导致失配。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [0, 130, 120, 100],
                "template": "Lobby/TaskCenterIcon.png",
                "threshold": 0.7
            }
        },
        "action": { "type": "Click", "param": {} },
        "next": [],
        "post_delay": 800,
        "timeout": 3000
    },

    "Nav_PresenceTab": {
        "doc": "任务中心左侧「存在感」标签。四个标签共用大 ROI（任务/存在感/每周任务/使魔探险），靠 expected 唯一性区分；x 上界刻意收窄到 140，避开顶部的「每日存在感」标题。",
        "recognition": {
            "type": "OCR",
            "param": { "roi": [10, 200, 130, 290], "expected": ["存在感"] }
        },
        "action": { "type": "Click", "param": {} },
        "next": [],
        "post_delay": 800,
        "timeout": 3000
    },

