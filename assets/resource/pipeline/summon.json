{
    "Summon_Entry": {
        "doc": "使魔探险阶段。入口：任务中心 → 左侧「使魔探险」标签。每日任务「星辰的彼方：派遣或收回一次使魔探险」——领取已完成的探险即算「收回」，所以本阶段只需领取。TODO：把已接取数（N/10）补满的「接取新探险」流程尚未实现。注意领取会消耗已接取数（实测 8/10 → 7/10 → 6/10 → 5/10）。",
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "DoNothing", "param": {} },
        "next": [
            "[JumpBack]Common_DenyList",
            "[JumpBack]Common_NoticeConfirm",
            "Summon_Claim",
            "[JumpBack]Nav_GotoSummon",
            "Summon_Settle"
        ],
        "max_hit": 40
    },

    "Summon_Claim": {
        "doc": "领取一条已完成的探险。列表里每个「探索完成」的条目右侧都有「点击领取奖励」，OCR 会同时命中多条，MaaFramework 取最优的一条点击；外层 Summon_Entry 会重复调度直到没有可领的条目。ROI 覆盖整个右侧按钮列（列表可滚动，留了较大纵向余量）。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [900, 200, 340, 460],
                "expected": ["点击领取奖励"]
            }
        },
        "action": { "type": "Click", "param": {} },
        "next": [
            "[JumpBack]Summon_DismissReward",
            "[JumpBack]Common_DenyList",
            "[JumpBack]Common_NoticeConfirm",
            "Summon_Entry"
        ],
        "post_delay": 800,
        "timeout": 3000,
        "max_hit": 15
    },

    "Summon_DismissReward": {
        "doc": "关闭「获得奖励」弹窗。实测该弹窗没有按钮，是一层铺满全屏的遮罩，点屏幕任意位置即关闭；不关掉下一条「点击领取奖励」就点不到。这里点右下角空白处，该点击会被遮罩吃掉，不会误触下层控件。⚠️ 必须由调用方以 [JumpBack] 调用：本节点 next 为空，若作为普通 next 成员被「下降」到这里会直接终止整条任务。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [450, 190, 400, 90],
                "expected": ["获得奖励"]
            }
        },
        "action": {
            "type": "Click",
            "param": { "target": [1230, 660] }
        },
        "next": [],
        "post_delay": 600,
        "timeout": 1500,
        "max_hit": 15
    },

    "Summon_Settle": {
        "doc": "收尾清扫：最后一条奖励领取后，领体力触发的「信息提示」可能晚于上一步的检查窗口才弹出，导致本阶段结束时留着一个弹窗挡住后续阶段。这里在退出前再扫一遍。",
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "DoNothing", "param": {} },
        "next": [
            "[JumpBack]Common_DenyList",
            "[JumpBack]Common_NoticeConfirm",
            "Summon_PhaseDone"
        ]
    },

    "Summon_PhaseDone": {
        "doc": "使魔探险阶段结束，交给存在感阶段。",
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "DoNothing", "param": {} },
        "next": ["Presence_Entry"]
    }
}
