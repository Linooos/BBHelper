{
    "Summon_Entry": {
        "doc": "使魔探险阶段入口。本阶段的活干完后 Summon_Claim 不再命中，所以导航绝不能是 [JumpBack]（会让入口无限空转、耗尽 max_hit 后任务散架——实测踩过）。这里用「先试活、不中再走线性导航」的结构：导航是一条下降链，每步 next 指向下一步，最后一步落进 Summon_Loop。每日任务「星辰的彼方：派遣或收回一次使魔探险」——领取已完成的探险即算「收回」。接取新探险由 Summon_Accept_* 三步流水线完成，见下。注意领取会消耗已接取数（实测 8/10 → 4/10）。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "phase_begin",
                "custom_action_param": {
                    "phase": "使魔探险"
                }
            }
        },
        "next": [
            "Summon_Claim",
            "Summon_Nav"
        ]
    },
    "Summon_Nav": {
        "doc": "线性导航链的起点。顶部标签在任何页面都可见，所以「点首页」从哪儿都能回大厅；回到大厅后任务中心图标必然可匹配。因此不需要降级分支，一条直线即可。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Summon_Nav01Lobby"
        ]
    },
    "Summon_Nav01Lobby": {
        "doc": "导航第 1 步：点顶部「首页」回大厅。\n\n⚠️ 末尾挂 Summon_Nav_Fail：以前只写一个候选，失配会让整条任务报错。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    600,
                    40,
                    680,
                    70
                ],
                "expected": [
                    "首页"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "Summon_Nav02TaskCenter",
            "Summon_Nav_Fail"
        ],
        "post_delay": 1200,
        "timeout": 4000
    },
    "Summon_Nav02TaskCenter": {
        "doc": "导航第 2 步：点大厅左侧任务中心图标（无文字，TemplateMatch）。\n\n⚠️ 点完任务中心图标页面不一定立刻切好，接到 Summon_Nav03Retry 去重试。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    130,
                    120,
                    100
                ],
                "template": "Lobby/TaskCenterIcon.png",
                "threshold": 0.7
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "Summon_Nav03Retry",
            "Summon_Nav_Fail"
        ],
        "post_delay": 1200,
        "timeout": 4000
    },
    "Summon_Nav03Tab": {
        "doc": "导航第 3 步：切到任务中心左侧的「使魔探险」标签，然后进入循环体。\n\n⚠️ 末尾挂 Summon_PhaseDone：万一下一跳也没命中，平静收尾，不要让整条任务报错。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    10,
                    200,
                    130,
                    290
                ],
                "expected": [
                    "使魔探险"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "Summon_Loop",
            "Summon_PhaseDone"
        ],
        "post_delay": 1200,
        "timeout": 4000
    },
    "Summon_Loop": {
        "doc": "循环体：每轮先清弹窗，再领一条。列表里每个「探索完成」的条目右侧都有「点击领取奖励」，OCR 会同时命中多条，MaaFramework 取最优的一条点击。ROI 覆盖整个右侧按钮列（列表可滚动，留了较大纵向余量）。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "[JumpBack]Common_PopupGate",
            "Summon_Claim",
            "Summon_Accept_Click",
            "Summon_Settle"
        ],
        "max_hit": 40
    },
    "Summon_Claim": {
        "doc": "领取一条已完成的探险，然后回到 Summon_Loop 继续下一轮。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    900,
                    200,
                    340,
                    460
                ],
                "expected": [
                    "点击领取奖励"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "[JumpBack]Common_PopupGate",
            "Summon_Loop"
        ],
        "post_delay": 800,
        "timeout": 3000,
        "max_hit": 15
    },
    "Summon_Accept_Click": {
        "doc": "接取新探险第 1 步：点某条待接取条目右侧的「点击选择使魔」，打开使魔编队界面。列表里可能同时有多条匹配，MaaFramework 取最优的一条；外层 Summon_Loop 会一直重复直到一条都匹配不到（用户实测：条目会随接取不断上浮，所以不需要滚动）。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    950,
                    220,
                    200,
                    460
                ],
                "expected": [
                    "点击选择使魔"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "Summon_Accept_AutoAssign",
            "[JumpBack]Common_PopupGate",
            "Summon_Loop"
        ],
        "post_delay": 900,
        "timeout": 2500,
        "max_hit": 12
    },
    "Summon_Accept_AutoAssign": {
        "doc": "接取新探险第 2 步：点「一键派遣」自动配齐使魔。实测成功率从 0.00% 跳到 100.00%，特性槽与四个使魔槽全部填满。不做这一步直接点「出发」成功率是 0，不应出发。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    700,
                    600,
                    260,
                    70
                ],
                "expected": [
                    "一键派遣"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "Summon_Accept_Depart",
            "[JumpBack]Common_PopupGate",
            "Summon_Loop"
        ],
        "post_delay": 900,
        "timeout": 2500,
        "max_hit": 12
    },
    "Summon_Accept_Depart": {
        "doc": "接取新探险第 3 步：点「出发」正式派出，界面返回列表，然后回到循环体接取下一条。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    960,
                    600,
                    210,
                    70
                ],
                "expected": [
                    "出发"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "[JumpBack]Common_PopupGate",
            "Summon_Loop"
        ],
        "post_delay": 900,
        "timeout": 2500,
        "max_hit": 12
    },
    "Summon_Settle": {
        "doc": "收尾清扫：最后一条奖励领取后，领体力触发的「信息提示」可能晚于上一步的检查窗口才弹出，导致本阶段结束时留着一个弹窗挡住后续阶段。这里在退出前再扫一遍。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "[JumpBack]Common_PopupGate",
            "Summon_PhaseDone"
        ]
    },
    "Summon_PhaseDone": {
        "doc": "使魔探险阶段结束，直接接存在感的第一类任务「使魔的爱」。\n\n⚠️ 不经过任何「存在感页领取」动作 —— 领取属于收尾的 ClaimRewards 链，不在这里做。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "phase_end",
                "custom_action_param": {
                    "phase": "使魔探险"
                }
            }
        },
        "next": [
            "Presence_SummonLove_Gate"
        ]
    },
    "Summon_Nav03Retry": {
        "doc": "使魔探险 导航的**重试汇合点**。\n\n实测点完上一步之后页面不一定会立刻切好，直接咬死一个候选会失配。\n给它 3 次机会（1.2s 间隔），还不行才回退去重点一次。\n\nnext 第二个候选是回退分支，保证它永不空手而归。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Summon_Nav03Tab",
            "Summon_Nav03Reclick"
        ],
        "post_delay": 1200,
        "max_hit": 3
    },
    "Summon_Nav03Reclick": {
        "doc": "重试分支：回退重新点一次「任务中心图标」，然后回到重试汇合点。\n\n⚠️ 只被 Retry 求值，而 Retry 的 max_hit 是 3 —— 整个回退循环最多 3 轮就有刹车。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Summon_Nav02TaskCenter",
            "Summon_Nav_Fail"
        ]
    },
    "Summon_Nav_Fail": {
        "doc": "使魔探险 导航的**放弃点**。\n\n导航没走通时不报错、不终止 —— 平静交给 Summon_PhaseDone，让日常继续往下跑。\n这一次没做到，下次跑还会再试；总比整条任务挂掉好。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Summon_PhaseDone"
        ]
    }
}
