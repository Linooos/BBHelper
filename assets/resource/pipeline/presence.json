{
    "Presence_Entry": {
        "doc": "存在感阶段入口。结构与 Summon_Entry 相同：先试活，不中再走线性导航链。入口：大厅左侧任务中心图标 → 左侧「存在感」标签。每日 8 条任务，满分 150。任务列表顺序可能每日变化，「前往」按钮的 y 随行变，需动态定位（CustomRecognition presence_find_task_row）。当前只实现了顶部里程碑的「一键领取」，逐条任务的执行见各 *_Gate 分支（阶段 4/6 实现）。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Presence_ClaimMilestone",
            "Presence_Nav"
        ]
    },
    "Presence_Nav": {
        "doc": "线性导航链起点，理由同 Summon_Nav。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Presence_Nav01Lobby"
        ]
    },
    "Presence_Nav01Lobby": {
        "doc": "导航第 1 步：点顶部「首页」回大厅。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    600,
                    40,
                    680,
                    70
                ],
                "expected": [
                    "首页"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "Presence_Nav02TaskCenter"
        ],
        "post_delay": 1200,
        "timeout": 4000
    },
    "Presence_Nav02TaskCenter": {
        "doc": "导航第 2 步：点大厅左侧任务中心图标（TemplateMatch）。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    130,
                    120,
                    100
                ],
                "template": "Lobby/TaskCenterIcon.png",
                "threshold": 0.7
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "Presence_Nav03Tab"
        ],
        "post_delay": 1200,
        "timeout": 4000
    },
    "Presence_Nav03Tab": {
        "doc": "导航第 3 步：切到「存在感」标签，进入循环体。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    10,
                    200,
                    130,
                    290
                ],
                "expected": [
                    "存在感"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "Presence_Loop"
        ],
        "post_delay": 1200,
        "timeout": 4000
    },
    "Presence_Loop": {
        "doc": "循环体：先清弹窗，再尝试领里程碑。里程碑领完后「一键领取」按钮可能仍在（置灰），OCR 依然读得到文字，靠 Presence_ClaimMilestone 的 max_hit 收敛。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "[JumpBack]Common_TapToDismiss",
            "[JumpBack]Common_DenyList",
            "[JumpBack]Common_NoticeConfirm",
            "Presence_ClaimMilestone",
            "Presence_CombatTask_Gate"
        ],
        "max_hit": 12
    },
    "Presence_ClaimMilestone": {
        "doc": "领取顶部里程碑奖励（20/40/60/80/100/150 六个星星的「一键领取」）。按钮在页头右侧，x 区间与邮件页的「一键领取」无关。领完会弹「已领取以下奖励」（点空白处关闭）。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    945,
                    195,
                    160,
                    55
                ],
                "expected": [
                    "一键领取"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "[JumpBack]Common_TapToDismiss",
            "[JumpBack]Common_DenyList",
            "[JumpBack]Common_NoticeConfirm",
            "Presence_CombatTask_Gate"
        ],
        "post_delay": 800,
        "timeout": 3000,
        "max_hit": 2
    },
    "Presence_CombatTask_Gate": {
        "doc": "分类切点：火线救援（使魔的爱）/ 世界这么大（虚轴之庭），消耗体力，走快捷战斗。默认直通到下一个切点；interface.json 打开「战斗类每日」时会把具体任务节点插到这里。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Presence_ShopPurchase_Gate"
        ]
    },
    "Presence_ShopPurchase_Gate": {
        "doc": "分类切点：战力补强（真实消费）。默认直通；由 interface.json 的「购物类每日」控制。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Presence_Resonance_Gate"
        ]
    },
    "Presence_Resonance_Gate": {
        "doc": "分类切点：共鸣之力（刷新共鸣屋，可能消耗水晶）。默认直通；由 interface.json 的「共鸣屋刷新」控制。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
