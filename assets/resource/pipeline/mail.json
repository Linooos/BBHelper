{
    "Mail_Entry": {
        "doc": "邮件阶段入口。先试活（已在邮件页则直接领），不中再走线性导航链。⚠️ 安全红线：邮件页「一键删除」(788,144) 会真实删除邮件，本文件任何节点的 ROI 都不得覆盖 x∈[740,845]。领取节点 ROI 分别锁死在 x∈[1055,1210] 与 x∈[880,1010]，与删除按钮物理隔离。改 ROI 前务必重新核对。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Mail_Loop",
            "Mail_Nav"
        ]
    },
    "Mail_Nav": {
        "doc": "线性导航链起点。顶部「社交」标签在任何页面都可见，所以一条直线即可。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "Mail_Nav01Social"
        ]
    },
    "Mail_Nav01Social": {
        "doc": "导航第 1 步：点顶部「社交」标签。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    600,
                    40,
                    680,
                    70
