    "Mail_Loop": {
        "doc": "循环体。Mail_ClaimAll 的 max_hit 为 1：一键领取按钮常驻（无可领时置灰），OCR 依然读得到文字，若不限次会一直命中导致死循环。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "[JumpBack]Common_PopupGate",
            "Mail_ClaimStamina",
            "Mail_ClaimAll",
            "Mail_PhaseDone"
        ],
        "max_hit": 5
    },
    "Mail_ClaimAll": {
        "doc": "一键领取。ROI 锁死在按钮本身，与「一键删除」物理隔离。点击后会弹出「领取成功」窗口。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1055,
                    118,
                    155,
                    52
                ],
                "expected": [
                    "一键领取"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "Mail_DismissClaimPopup",
            "Mail_Loop"
        ],
        "post_delay": 800,
        "timeout": 2500,
        "max_hit": 1
    },
    "Mail_DismissClaimPopup": {
        "doc": "关闭「领取成功」弹窗。用户实测：该弹窗没有自己的按钮，只能靠点顶部导航关掉。TODO(待验证)：弹窗文案「领取成功」与 ROI 均未经实机确认（2026-09-18 当时邮件已领完，无法重现）。识别失败会落到 Mail_Loop，此时下一阶段的导航链第 1 步也会点「首页」，可自愈。",
        "recognition": {
            "type": "OCR",
            "param": {
