{
    "Common_OcrBase": {
        "doc": "OCR 基座节点。自身不带 roi/expected，仅供 CustomRecognition 通过 context.run_recognition 临时覆盖参数使用，不参与主流程。",
        "recognition": {"type": "OCR", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "next": []
    },

    "Common_TapToDismiss": {
        "doc": "关闭「点空白处关闭」型的奖励弹窗。实测有两种，都没有按钮、点任意位置关闭：使魔探险领取后的「获得奖励」，以及存在感里程碑领取后的「已领取以下奖励」（后者正文直接写着「（点击空白处关闭）」）。两者标题位置不同，用一个覆盖两者的纵向 ROI。点击点选在两个弹窗都空白的区域，避免误触下层页面控件。⚠️ 必须由调用方以 [JumpBack] 调用（本节点 next 为空，作为普通 next 成员「下降」到这里会终止整条任务）。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    420,
                    110,
                    450,
                    170
                ],
                "expected": [
                    "获得奖励",
                    "已领取以下奖励"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {"target": [
                    640,
                    445
                ]}
        },
        "next": [],
        "post_delay": 600,
        "timeout": 1500,
        "max_hit": 15
    },

    "Common_DenyList": {
        "doc": "安全闸：弹窗里出现消耗/破坏性文案就中止整条任务链。词表刻意保持很窄，只拦真正的危险操作，避免误伤正常流程。使用时**直接**放进父节点的 next（不要包一层 DirectHit，见 dev_loop.md「恒命中节点」）。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    340,
                    180,
                    600,
                    360
                ],
                "expected": [
                    "删除",
                    "消耗水晶",
                    "确认购买",
                    "立即购买",
                    "确认花费",
                    "确认消耗"
                ]
            }
        },
        "action": {"type": "StopTask", "param": {}},
        "timeout": 1500
    },

    "Common_NoticeConfirm": {
        "doc": "中央「确定」按钮，用于关闭各种提示框（如使魔探险的「信息提示：体力已经达到上限」）。ROI 锁死在按钮本身，不覆盖上方文案区。⚠️ 该位置既可能是普通提示、也可能是消耗确认框，所以它在父节点 next 里的顺序必须排在 Common_DenyList 之后。max_hit 防止弹窗关不掉时无限循环。",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    430,
                    200,
                    70
                ],
                "expected": ["确定"]
            }
        },
        "action": {"type": "Click", "param": {}},
        "next": [],
        "timeout": 1500,
        "max_hit": 20
    }
}
