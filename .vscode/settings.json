{
    // Maa Pipeline Support 插件通过「终端任务」启动 Agent（命令形如 `python ./agent/main.py <socket_id>`），
    // 而 interface.json 里 agent.child_exec 写的是发布布局的 `python`。
    // 本机没有系统 Python，所以把项目 venv 的 Scripts 目录追加进终端 PATH，
    // 让 `python` 能解析到 .venv 里的解释器 —— 这样 interface.json 保持发布布局不变。
    // ⚠️ 改完需要重启 VS Code（或重开终端）才生效。
    "terminal.integrated.env.windows": {
        "PATH": "${env:PATH};${workspaceFolder}\\.venv\\Scripts"
    },
    "json.schemas": [
        {
            "fileMatch": [
                "/assets/resource/**/*.json",
                "/install/resource/**/*.json",
                "/assets/resource/**/*.jsonc",
                "/install/resource/**/*.jsonc"
            ],
            "url": "/deps/tools/pipeline.schema.json"
        },
        {
            "fileMatch": [
                "/assets/interface.json",
                "/install/interface.json"
            ],
            "url": "/deps/tools/interface.schema.json"
        },
        {
            "fileMatch": [
                "/install/config/maa_pi_config.json"
            ],
            "url": "/deps/tools/interface_config.schema.json"
        }
    ],
    "files.associations": {
        "**/assets/**/*.json": "jsonc"
    },
    "[json][jsonc]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.indentSize": "tabSize"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[markdown]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    }
}
